# =============================================================================
# CONMAN - Environment Configuration Template
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
# =============================================================================

# HTTP Server Port
PORT=5173

# Database Configuration
# Supported drivers: "sqlite" (default) or "postgres"
DATABASE_DRIVER=sqlite
DATABASE_URL=/app/data/app.db

# PostgreSQL Configuration (uncomment if using DATABASE_DRIVER=postgres)
# DATABASE_DSN=host=conman-db port=5432 user=conman password=conman dbname=conman sslmode=disable

# Security Secrets (REQUIRED in production)
# Must be set to secure random strings (e.g. `openssl rand -hex 32`).
# The server will refuse to start if unset or using default placeholder values.
SECRET_KEY=your-secure-random-secret-key-at-least-32-characters
MASTER_API_KEY=your-secure-random-master-api-key-at-least-32-chars

# Initial Administrator Credentials
# ADMIN_PASSWORD is set/reset on startup to allow recovery
ADMIN_EMAIL=admin@conman.local
ADMIN_PASSWORD=change-me-in-production

# Agent Authentication Token
# Pre-shared secret required for agent nodes to connect to this server
AGENT_TOKEN=your-agent-pre-shared-token

# Static Files Directory
# Path to built frontend static assets (leave empty if served externally)
STATIC_DIR=/app/static

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Local Docker Engine Socket
DOCKER_HOST=unix:///var/run/docker.sock

# Licencia Licensing Integration (optional - leave empty for Community tier)
# LICENSE_KEY: Your Licencia license key
# LICENCIA_URL: Licencia server URL (e.g. https://licencia.deziss.com)
# LICENCIA_API_KEY: Licencia API key with license:validate scope
LICENSE_KEY=
LICENCIA_URL=
LICENCIA_API_KEY=

# Com0 Integration (optional)
COM0_API_URL=
